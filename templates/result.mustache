{{!
    @template local_roleexplainer/result

    Deterministic permission trace followed by an optional AI explanation.
}}
<div class="local-roleexplainer-result mt-4">
    <div class="alert alert-{{resultclass}}" role="status">
        <h3 class="h5 mb-2">{{#str}}officialresult, local_roleexplainer{{/str}}: {{resultlabel}}</h3>
        <div><strong>{{#str}}targetuserlabel, local_roleexplainer{{/str}}:</strong> {{userdisplay}}</div>
        <div><strong>{{#str}}capabilityname, local_roleexplainer{{/str}}:</strong> <code>{{capability}}</code></div>
        <div><strong>{{#str}}context, local_roleexplainer{{/str}}:</strong> {{contextdisplay}}</div>
        <div><strong>{{#str}}doanything, local_roleexplainer{{/str}}:</strong> {{doanything}}</div>
        {{#showwithoutdoanything}}
            <div><strong>{{#str}}withoutadminshortcut, local_roleexplainer{{/str}}:</strong> {{withoutdoanything}}</div>
        {{/showwithoutdoanything}}
        <div class="mt-2"><strong>{{#str}}decisivefactors, local_roleexplainer{{/str}}:</strong> {{reason}}</div>
    </div>

    {{#capabilitymissing}}
        <div class="alert alert-warning">{{#str}}missingcapability, local_roleexplainer{{/str}}</div>
    {{/capabilitymissing}}

    <h3 class="h5 mt-4">{{#str}}contextchain, local_roleexplainer{{/str}}</h3>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
            <tr>
                <th>{{#str}}contextidlabel, local_roleexplainer{{/str}}</th>
                <th>{{#str}}contextlevel, local_roleexplainer{{/str}}</th>
                <th>{{#str}}context, local_roleexplainer{{/str}}</th>
                <th>{{#str}}contextinstance, local_roleexplainer{{/str}}</th>
            </tr>
            </thead>
            <tbody>
            {{#contexts}}
                <tr{{#istarget}} class="table-active"{{/istarget}}>
                    <td>{{id}}</td>
                    <td>{{level}}</td>
                    <td>{{name}}</td>
                    <td>{{instanceid}}</td>
                </tr>
            {{/contexts}}
            </tbody>
        </table>
    </div>

    <h3 class="h5 mt-4">{{#str}}rolechain, local_roleexplainer{{/str}}</h3>
    {{^hasroles}}
        <div class="alert alert-secondary">{{#str}}noexplicitroles, local_roleexplainer{{/str}}</div>
    {{/hasroles}}
    {{#roles}}
        <div class="card mb-3">
            <div class="card-header">
                <strong>{{rolename}}</strong> (#{{roleid}})
                {{#shortname}}<code class="ms-2">{{shortname}}</code>{{/shortname}}
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>{{#str}}archetype, local_roleexplainer{{/str}}:</strong> {{archetype}}</p>
                <p class="mb-1"><strong>{{#str}}assignmentsource, local_roleexplainer{{/str}}:</strong> {{sources}}</p>
                <p class="mb-3"><strong>{{#str}}
                    effectivepermission, local_roleexplainer{{/str}}:</strong> {{effectivepermission}}</p>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                        <tr>
                            <th>{{#str}}context, local_roleexplainer{{/str}}</th>
                            <th>{{#str}}permission, local_roleexplainer{{/str}}</th>
                            <th>{{#str}}source, local_roleexplainer{{/str}}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{#rules}}
                            <tr{{#rowclass}} class="{{rowclass}}"{{/rowclass}}>
                                <td>{{contextname}} (#{{contextid}})</td>
                                <td>{{permission}}{{#effective}}<span class="badge bg-info">{{#str}}
                                    effective, local_roleexplainer{{/str}}</span>{{/effective}}</td>
                                <td>{{source}}</td>
                            </tr>
                        {{/rules}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {{/roles}}

    {{#aierror}}
        <div class="alert alert-warning mt-4">{{aierror}}</div>
    {{/aierror}}

    {{#ai}}
        <div class="card mt-4">
            <div class="card-header"><strong>{{#str}}aiexplanation, local_roleexplainer{{/str}}</strong></div>
            <div class="card-body">
                {{#summary}}
                    <h4 class="h6">{{#str}}aisummary, local_roleexplainer{{/str}}</h4>
                    <div>{{{summary}}}</div>
                {{/summary}}
                {{#hasdecisive}}
                    <h4 class="h6 mt-3">{{#str}}decisiverules, local_roleexplainer{{/str}}</h4>
                    <ul>
                        {{#decisive_rules}}
                            <li>{{text}}</li>{{/decisive_rules}}
                    </ul>
                {{/hasdecisive}}
                {{#explanation}}
                    <div class="mt-3">{{{explanation}}}</div>
                {{/explanation}}
                {{#haschecks}}
                    <h4 class="h6 mt-3">{{#str}}suggestedchecks, local_roleexplainer{{/str}}</h4>
                    <ul>
                        {{#suggested_checks}}
                            <li>{{text}}</li>{{/suggested_checks}}
                    </ul>
                {{/haschecks}}
            </div>
        </div>
    {{/ai}}

    {{#haslinks}}
        <div class="card mt-4">
            <div class="card-header"><strong>{{#str}}links, local_roleexplainer{{/str}}</strong></div>
            <div class="card-body">
                {{#links}}
                    <a class="btn btn-secondary btn-sm me-2 mb-2" href="{{url}}">{{label}}</a>
                {{/links}}
            </div>
        </div>
    {{/haslinks}}
</div>
